# Local defaults already use a persistent H2 file under backend/.data.
# Set this profile only when testing the explicit in-memory fallback:
SPRING_PROFILES_ACTIVE=memory

# Cloud Run values (deploy.sh supplies these; never paste a password here)
BIZLAMA_GCP_PROJECT_ID=bizlama
BIZLAMA_CLOUD_SQL_INSTANCE=bizlama:asia-south1:bizlama-db
BIZLAMA_DB_NAME=bizlama
BIZLAMA_DB_USER=bizlama_app
BIZLAMA_RECEIPT_STORAGE=gcs
BIZLAMA_RECEIPTS_BUCKET=bizlama-receipts-PROJECT_NUMBER
BIZLAMA_VERTEX_AI_ENABLED=true
BIZLAMA_BIGQUERY_ENABLED=true
BIZLAMA_BIGQUERY_DATASET=bizlama_analytics
BIZLAMA_SHELF_LIFE_MODE=database
BIZLAMA_AUTH_MODE=local
BIZLAMA_OWNER_EMAIL=owner@bizlama.local
BIZLAMA_OWNER_NAME=Madhu
BIZLAMA_OWNER_PASSWORD=change-me
BIZLAMA_AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes